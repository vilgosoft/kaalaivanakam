# Save as public_html/api/.env on Hostinger (never commit real secrets).

# Short names (supported by api/config/config.php):
APP_ENV=production
# Set true locally to see exception details on 500 responses
APP_DEBUG=false

# Use 127.0.0.1 on Windows if "localhost" fails. Many local stacks use port 3307 (see phpMyAdmin URL).
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=paperkaaran
DB_USER=root
DB_PASS=

# Use a long random string. If it contains # wrap the whole value in double quotes: JWT_SECRET="...."
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_TTL=3600

# Or use PAPERKAARAN_* names instead (they win if set):
# PAPERKAARAN_DB_HOST=localhost
# PAPERKAARAN_DB_NAME=...
# PAPERKAARAN_JWT_SECRET=...

# Optional full DSN (overrides host/port/name):
# PAPERKAARAN_DB_DSN=mysql:host=localhost;port=3306;dbname=...;charset=utf8mb4
